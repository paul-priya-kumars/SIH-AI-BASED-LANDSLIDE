# Landslide AI Monitoring & Early Warning System - Environment Configuration
# Phase 1 Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database (SQLite for Phase 1; easily interchangeable with PostgreSQL/PostGIS in Phase 2)
DATABASE_URL=sqlite:///./landslide.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Integration flags
MOCK_M1_ML=True
MOCK_M2_GIS=True

# Observability
ENABLE_METRICS=True
LOG_LEVEL=INFO