# ---------------------------------------------------------------------------
# GeoShield AI / JARVIS — root .gitignore
# Excludes generated, secret and large binary artifacts.
# Never excludes source code, tests, README, requirements, frontend source or
# required model configuration files.
# ---------------------------------------------------------------------------

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Databases ---
*.db
*.sqlite
*.sqlite3
*.db-journal

# --- Logs / runtime state ---
*.log
logs/
*.pid

# --- Backups / temporary / debug ---
*.bak
*.backup
*.tmp
*.temp
*.orig
*.rej
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/

# --- Node / frontend build output ---
node_modules/
dist/
build/
*.tsbuildinfo
.vite/

# --- User uploads ---
uploads/

# --- Images / screenshots (generated), keep required frontend assets ---
*.png
!frontend/src/assets/*.png
!frontend/public/**/*.png
!.github/**/*.png

# --- Model artifacts / checkpoints (weights are large; configs stay tracked) ---
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.h5
*.pkl
*.joblib
*.bin
*.npz
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/README.md
!**/checkpoints/.gitkeep
!**/checkpoints/README.md
